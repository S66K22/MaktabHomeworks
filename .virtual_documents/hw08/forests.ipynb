


import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay
import matplotlib.pyplot as plt








df = pd.read_csv("heart_cleveland_upload.csv")
df.head(1).T


df.isna().sum()





train_data, test_data = train_test_split(df, test_size=30, random_state=42)

print(f"train_data.shape: {train_data.shape}")
print(f"test_data.shape: {test_data.shape}")





rf_clf = RandomForestClassifier(n_estimators=100, criterion='gini', max_depth=4, random_state=42)
rf_clf.fit(train_data.iloc[:, :-1], train_data.iloc[:, -1])


rf_clf.score(train_data.iloc[:, :-1], train_data.iloc[:, -1])


rf_clf.score(test_data.iloc[:, :-1], test_data.iloc[:, -1])








from sklearn.inspection import permutation_importance

feature_names = train_data.columns[:-1]

result = permutation_importance(
    rf_clf, train_data.iloc[:, :-1], train_data.iloc[:, -1], n_repeats=10, random_state=42
)

sorted_idx = result.importances_mean.argsort()
means = result.importances_mean[sorted_idx]
stds = result.importances_std[sorted_idx]
names = [feature_names[i] for i in sorted_idx]

# Set up bar width and positions
bar_width = 0.35
y_pos = np.arange(len(names))

# Plot mean importance
plt.barh(y_pos, means, bar_width, label='Mean Importance', color='skyblue')

# Plot std side by side
plt.barh(y_pos + bar_width, stds, bar_width, label='Std Dev', color='salmon')

plt.yticks(y_pos + bar_width / 2, names)
plt.xlabel('Importance Value')
plt.title('Permutation Feature Importances (Mean & Std)')
plt.legend()
plt.show()








ConfusionMatrixDisplay.from_estimator(
    rf_clf,
    test_data.iloc[:, :-1],
    test_data.iloc[:, -1]
)

plt.show()






